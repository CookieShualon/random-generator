/* Textual CSS Theme for Random Generator TUI */

Screen {
    background: $surface;
}

/* Header Styling */
Header {
    dock: top;
    height: 3;
    background: $primary;
    color: $text;
    content-align: center middle;
}

Header .title {
    text-style: bold;
    color: $text;
}

/* Footer Styling */
Footer {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
}

/* Navigation Sidebar */
#navigation {
    width: 20;
    dock: left;
    background: $panel;
    border-right: tall $primary;
    padding: 1;
}

#navigation Button {
    width: 100%;
    margin-bottom: 1;
    background: transparent;
    border: none;
    text-align: left;
    color: $text;
}

#navigation Button:hover {
    background: $primary-darken-1;
    color: $text;
}

#navigation Button.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#navigation .separator {
    height: 1;
    margin: 1 0;
    border-bottom: solid $primary;
}

/* Main Content Area */
#content {
    padding: 2 4;
    height: 100%;
}

.screen-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 2;
}

/* Form Elements */
.form-group {
    margin-bottom: 1;
}

.form-label {
    color: $text;
    margin-bottom: 0;
}

Input {
    border: solid $primary;
    background: $surface-darken-1;
    color: $text;
    margin-bottom: 1;
    height: 3;
    width: 100%;
}

Input:focus {
    border: solid $accent;
}

Input.-error {
    border: tall $error;
}

/* TextArea Styling */
TextArea {
    border: tall $primary;
    background: $surface-darken-1;
    color: $text;
    margin-bottom: 1;
    width: 100%;
    min-height: 8;
}

TextArea:focus {
    border: tall $accent;
}

.input-hint {
    color: $text-muted;
    text-style: italic;
}

.error-message {
    color: $error;
    text-style: bold;
}

/* Buttons */
Button {
    background: $primary;
    color: $text;
    border: tall $primary-darken-2;
    min-width: 16;
    margin: 0 1;
}

Button:hover {
    background: $primary-lighten-1;
}

Button:focus {
    border: tall $accent;
}

Button.-primary {
    background: $success;
    border: tall $success-darken-2;
}

Button.-primary:hover {
    background: $success-lighten-1;
}

Button.-secondary {
    background: $panel;
    border: tall $primary;
}

Button.-secondary:hover {
    background: $panel-lighten-1;
}

Button.-danger {
    background: $error;
    border: tall $error-darken-2;
}

Button.-danger:hover {
    background: $error-lighten-1;
}

.button-group {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: 2;
}

/* Radio Buttons */
RadioSet {
    background: transparent;
    border: none;
}

RadioButton {
    background: transparent;
    color: $text;
}

RadioButton:focus {
    background: $primary-darken-2;
}

/* Select/Dropdown */
Select {
    border: tall $primary;
    background: $surface-darken-1;
}

Select:focus {
    border: tall $accent;
}

/* Results Display */
#results-container {
    border: tall $primary;
    background: $surface-darken-1;
    padding: 1;
    margin-top: 2;
    height: auto;
    min-height: 10;
}

.result-item {
    color: $text;
    margin: 0 0 1 0;
}

.result-color-swatch {
    width: 4;
    height: 1;
    margin-right: 1;
}

/* Preview Section */
.preview-section {
    border: tall $accent;
    background: $surface-darken-2;
    padding: 1;
    margin: 1 0;
}

.preview-label {
    color: $accent;
    text-style: bold;
}

.preview-content {
    color: $text-muted;
}

/* History Table */
DataTable {
    border: tall $primary;
    background: $surface-darken-1;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-darken-1;
}

/* Settings */
.settings-section {
    border: tall $primary;
    padding: 1;
    margin-bottom: 2;
}

.settings-section-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

/* Help Screen */
.help-section {
    margin-bottom: 2;
}

.help-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.help-content {
    color: $text;
    margin-left: 2;
}

.keyboard-shortcut {
    color: $accent;
    text-style: bold;
}

/* Notifications */
.notification {
    background: $primary;
    color: $text;
    padding: 1 2;
    border: tall $primary-darken-2;
}

.notification.-success {
    background: $success;
    border: tall $success-darken-2;
}

.notification.-error {
    background: $error;
    border: tall $error-darken-2;
}

.notification.-warning {
    background: $warning;
    border: tall $warning-darken-2;
}

/* Loading Spinner */
LoadingIndicator {
    color: $primary;
}

/* Quick Action Cards (Home Screen) */
.quick-action-card {
    border: tall $primary;
    background: $surface-darken-1;
    padding: 2;
    width: 20;
    height: 8;
    margin: 0 1;
}

.quick-action-card:hover {
    background: $primary-darken-2;
    border: tall $accent;
}

.quick-action-icon {
    text-align: center;
    color: $primary;
    text-style: bold;
}

.quick-action-title {
    text-align: center;
    color: $text;
    text-style: bold;
    margin-top: 1;
}

.quick-action-subtitle {
    text-align: center;
    color: $text-muted;
}

/* Template Syntax Box */
.template-syntax {
    border: tall $accent;
    background: $surface-darken-2;
    padding: 1;
    margin: 1 0;
}

.template-syntax-item {
    color: $text;
}

.template-placeholder {
    color: $accent;
    text-style: bold;
}

/* Common Templates List */
.common-templates {
    margin-top: 1;
}

.template-example {
    color: $text-muted;
    margin-left: 2;
}

/* Scrollable Containers */
.scrollable {
    overflow-y: auto;
    height: 100%;
}

/* Utility Classes */
.text-center {
    text-align: center;
}

.text-muted {
    color: $text-muted;
}

.text-success {
    color: $success;
}

.text-error {
    color: $error;
}

.text-warning {
    color: $warning;
}

.text-bold {
    text-style: bold;
}

.margin-top-1 {
    margin-top: 1;
}

.margin-top-2 {
    margin-top: 2;
}

.margin-bottom-1 {
    margin-bottom: 1;
}

.margin-bottom-2 {
    margin-bottom: 2;
}
